{
    "name":  "nexora-media-processing",
    "version":  "1.1.11",
    "description":  "Plataforma profissional de processamento de media broadcast \u0026 OTT",
    "main":  "dist/index.js",
    "scripts":  {
                    "dev":  "tsx watch src/index.ts",
                    "build":  "tsc --noEmit \u0026\u0026 tsc -p tsconfig.build.json",
                    "start":  "node dist/index.js",
                    "worker":  "tsx src/worker.ts",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "test:coverage":  "vitest run --coverage",
                    "test:e2e":  "playwright test",
                    "lint":  "eslint src --ext .ts",
                    "lint:fix":  "eslint src --ext .ts --fix",
                    "format":  "prettier --write \"src/**/*.ts\"",
                    "db:migrate":  "prisma migrate deploy",
                    "db:migrate:dev":  "prisma migrate dev",
                    "db:seed":  "tsx prisma/seed.ts",
                    "db:studio":  "prisma studio",
                    "db:generate":  "prisma generate",
                    "queue:flush":  "tsx scripts/flush-queues.ts",
                    "fixtures:generate":  "bash tests/fixtures/generate-fixtures.sh",
                    "keys:generate":  "npx tsx scripts/nexora-generate-keys.ts",
                    "setup":  "node arquitetura/nexora-scaffold.js",
                    "nexora":  "pwsh nexora.ps1"
                },
    "dependencies":  {
                         "@fastify/cors":  "^11.2.0",
                         "@fastify/helmet":  "^13.0.2",
                         "@fastify/jwt":  "^10.0.0",
                         "@fastify/multipart":  "^10.0.0",
                         "@fastify/rate-limit":  "^10.3.0",
                         "@fastify/swagger":  "^9.7.0",
                         "@prisma/client":  "^5.11.0",
                         "@temporalio/activity":  "^1.9.0",
                         "@temporalio/client":  "^1.9.0",
                         "@temporalio/worker":  "^1.9.0",
                         "@temporalio/workflow":  "^1.9.0",
                         "bullmq":  "^5.7.0",
                         "fastify":  "^5.8.5",
                         "ioredis":  "^5.3.0",
                         "jose":  "^5.2.0",
                         "minio":  "^8.0.0",
                         "pino":  "^9.1.0",
                         "pino-pretty":  "^11.0.0",
                         "prom-client":  "^15.1.0",
                         "systeminformation":  "^5.31.5",
                         "uuid":  "^9.0.0",
                         "zod":  "^3.22.0"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.44.0",
                            "@testcontainers/postgresql":  "^10.7.0",
                            "@testcontainers/redis":  "^10.7.0",
                            "@types/k6":  "^1.7.0",
                            "@types/node":  "^20.11.0",
                            "@types/supertest":  "^7.2.0",
                            "@types/uuid":  "^10.0.0",
                            "@typescript-eslint/eslint-plugin":  "^7.4.0",
                            "@typescript-eslint/parser":  "^7.4.0",
                            "@vitest/coverage-v8":  "^1.4.0",
                            "eslint":  "^8.57.0",
                            "prettier":  "^3.2.0",
                            "prisma":  "^5.11.0",
                            "supertest":  "^7.2.2",
                            "tsx":  "^4.7.0",
                            "typescript":  "^5.4.0",
                            "vitest":  "^1.4.0"
                        },
    "prisma":  {
                   "seed":  "tsx prisma/seed.ts"
               }
}
