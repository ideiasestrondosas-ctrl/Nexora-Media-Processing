{
  "uid": "nexora-quality",
  "title": "Nexora Quality",
  "description": "Métricas de qualidade: VMAF, loudness EBU R128, rejeições",
  "tags": ["nexora", "quality", "vmaf"],
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-3h", "to": "now" },
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "VMAF Mediano (P50)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 85 },
              { "color": "green", "value": 90 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, rate(nexora_vmaf_score_bucket[15m]))",
          "legendFormat": "VMAF P50"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "VMAF Mínimo (P1)",
      "description": "Quality floor — ADR-010",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "green", "value": 85 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.01, rate(nexora_vmaf_score_bucket[15m]))",
          "legendFormat": "VMAF P1 (floor)"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Taxa de Rejeição",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "minVizWidth": 75
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.10 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(nexora_assets_rejected_total[5m]) / (rate(nexora_assets_ingested_total[5m]) + 0.001)",
          "legendFormat": "rejection rate"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Falhas VMAF (total)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(nexora_vmaf_failures_total)",
          "legendFormat": "total failures"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Distribuição VMAF por Perfil",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, rate(nexora_vmaf_score_bucket[15m]))",
          "legendFormat": "P95 VMAF"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, rate(nexora_vmaf_score_bucket[15m]))",
          "legendFormat": "P50 VMAF"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.05, rate(nexora_vmaf_score_bucket[15m]))",
          "legendFormat": "P5 VMAF"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Distribuição Loudness (LUFS Integrado)",
      "description": "Target EBU R128: -23 LUFS broadcast, -16 LUFS OTT — ADR-005",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, rate(nexora_loudness_lufs_bucket[15m]))",
          "legendFormat": "LUFS P50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, rate(nexora_loudness_lufs_bucket[15m]))",
          "legendFormat": "LUFS P95"
        }
      ]
    }
  ]
}
