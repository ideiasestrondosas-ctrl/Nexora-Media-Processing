{
  "uid": "nexora-overview",
  "title": "Nexora Overview",
  "description": "Visão geral do pipeline de processamento de media",
  "tags": ["nexora", "overview"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Jobs / min",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(nexora_assets_ingested_total[5m]) * 60",
          "legendFormat": "jobs/min"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Taxa de Sucesso",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "minVizWidth": 75,
        "minVizHeight": 75
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nexora_job_success_rate",
          "legendFormat": "success rate"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Queue Depth Total",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(nexora_queue_depth)",
          "legendFormat": "total jobs"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg Transcode Time",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1800 },
              { "color": "red", "value": 7200 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(nexora_transcode_duration_seconds_sum[5m]) / rate(nexora_transcode_duration_seconds_count[5m])",
          "legendFormat": "avg transcode"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Assets Processados vs Rejeitados",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(nexora_assets_ingested_total[5m]) * 60",
          "legendFormat": "Ingeridos / min"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(nexora_assets_rejected_total[5m]) * 60",
          "legendFormat": "Rejeitados / min"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Queue Depth por Worker",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nexora_queue_depth",
          "legendFormat": "{{ worker_type }}"
        }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Slots de Encoding em Uso",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 10
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nexora_scheduler_slots_used",
          "legendFormat": "{{ job_type }}"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "GPU Status",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "CPU Only", "color": "yellow" }, "1": { "text": "GPU Active", "color": "green" } }, "type": "value" }
          ]
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nexora_gpu_available",
          "legendFormat": "{{ gpu_type }}"
        }
      ]
    }
  ]
}
