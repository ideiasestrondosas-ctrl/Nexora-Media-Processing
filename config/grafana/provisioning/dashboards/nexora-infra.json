{
  "uid": "nexora-infra",
  "title": "Nexora Infrastructure",
  "description": "Métricas de infraestrutura: CPU, RAM, disco, rede por container",
  "tags": ["nexora", "infrastructure", "docker"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU por Container (%)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=~\"nexora.*\"}[2m]) * 100",
          "legendFormat": "{{ container_label_com_docker_compose_service }}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RAM por Container",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "container_memory_usage_bytes{container_label_com_docker_compose_service=~\"nexora.*\"}",
          "legendFormat": "{{ container_label_com_docker_compose_service }}"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Disco Disponível (%)",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 6 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "minVizWidth": 100
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.20 },
              { "color": "green", "value": 0.40 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\", fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype!=\"tmpfs\"}",
          "legendFormat": "/ (root)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rede I/O por Container",
      "gridPos": { "x": 8, "y": 8, "w": 16, "h": 6 },
      "options": {
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 1.5 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(container_network_transmit_bytes_total{container_label_com_docker_compose_service=~\"nexora.*\"}[2m])",
          "legendFormat": "TX {{ container_label_com_docker_compose_service }}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(container_network_receive_bytes_total{container_label_com_docker_compose_service=~\"nexora.*\"}[2m])",
          "legendFormat": "RX {{ container_label_com_docker_compose_service }}"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Estado dos Serviços",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 6 },
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "displayMode": "color-background" },
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ]
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up",
          "legendFormat": "{{ job }}",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Node.js Event Loop Lag",
      "description": "Valores altos indicam CPU saturada ou operações bloqueantes",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 6 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nexora_node_eventloop_lag_seconds",
          "legendFormat": "{{ job }}"
        }
      ]
    }
  ]
}
